      "PowerShell(ffprobe *)",
      "PowerShell(.venv\\Scripts\\python *)",
      "PowerShell(.venv/Scripts/python *)",
      "PowerShell(npx remotion *)",
      "PowerShell(cd montaj; npx remotion *)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(.venv/Scripts/python *)",
      "Bash(npx remotion *)",
      "Bash(cd montaj && npx remotion *)"
